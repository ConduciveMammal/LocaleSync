{
  "name": "@conducivemammal/shopify-locale-sync",
  "version": "0.1.0",
  "description": "Keep Shopify theme locale files structurally in sync.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConduciveMammal/LocaleSync.git"
  },
  "keywords": [
    "shopify",
    "shopify-cli",
    "oclif",
    "locales",
    "translations"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "localesync": "bin/localesync.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "/LICENSE",
    "/README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && oclif manifest",
    "dev": "tsx src/standalone.ts",
    "dev:plugin": "npm run build && node bin/run.js",
    "lint": "eslint .",
    "manifest": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.11",
    "eslint": "10.9.0",
    "oclif": "^4.23.30",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "oclif": {
    "bin": "shopify",
    "dirname": "localesync",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "theme:locales": {
        "description": "Keep Shopify theme locale files in sync."
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
